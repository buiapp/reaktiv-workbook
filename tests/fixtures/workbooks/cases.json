        {
          "id": "B1",
          "kind": "linked",
          "source": "counter * 2",
          "name": "price"
        },
        {
          "id": "B2",
          "kind": "formula",
          "source": "counter + price"
        },
        {
          "id": "C1",
          "kind": "effect",
          "source": "limit\nwith cells.batch():\n    cells.counter.update(lambda counter: limit)\n    cells.price.set(7)"
        },
        {
          "id": "D1",
          "kind": "effect",
          "trigger": "manual",
          "source": "cells.price.reset()"
        }
      ]
    },
    {
      "name": "cell-equality",
      "about": "Every value cell preserves its Python equality comparator in both writers.",
      "cells": [
        {
          "id": "A1",
          "kind": "input",
          "source": "1",
          "name": "amount",
          "equal": "lambda previous, current: abs(previous - current) < 0.01"
        },
        {
          "id": "B1",
          "kind": "formula",
          "source": "amount * 2",
          "equal": "lambda previous, current: previous is current"
        },
        {
          "id": "B2",
          "kind": "linked",
          "source": "amount * 3",
          "override": "5",
          "equal": "lambda previous, current: previous == current"
        },
        {
          "id": "C1",
          "kind": "resource",
          "source": "await asyncio.sleep(0.01)\nreturn amount",
          "equal": "lambda previous, current: previous == current"
        },
        {
          "id": "D1",
          "kind": "markdown",
          "source": "Amount: {{ amount }}",
          "equal": "lambda previous, current: False"
        }
      ]
    },
