    {
      "name": "multiline-function-cell",
      "about": "Multiline signatures return the helper; positional call arguments followed by a keyword remain reactive reads.",
      "cells": [
        {
          "id": "A1",
          "kind": "input",
          "source": "50",
          "name": "freq"
        },
        {
          "id": "A2",
          "kind": "input",
          "source": "4",
          "name": "num_samples"
        },
        {
          "id": "A3",
          "kind": "input",
          "source": "1000",
          "name": "fs"
        },
        {
          "id": "A5",
          "kind": "formula",
          "name": "generate_switching_pattern",
          "source": "def generate_toggle_on_negative(\n    freq: float,\n    num_samples: int,\n    fs: float,\n    enable_inversion: bool = True,\n) -> float:\n    \"\"\"A helper with a multiline signature.\"\"\"\n    return freq * num_samples / fs"
        },
        {
          "id": "B7",
          "kind": "formula",
          "name": "pulse_pattern_no_inversion",
          "source": "generate_switching_pattern(\n    freq,\n    num_samples,\n    fs,\n    enable_inversion=False\n)"
        }
      ]
    },
    {
      "name": "effect-input-writes",
