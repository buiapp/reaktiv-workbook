{
  "about": "Workbooks as the user types them. sheet-file.workbooks.spec.ts writes each with the app's writer to <name>.app.sheet.py; tests/python/test_workbook_files.py loads those files and requires every cell to come back as typed (or as in 'loads') with the same values.",
  "cases": [
    {
      "name": "labels",
      "about": "References by label in every Python context, and a note with a live value and a widget.",
      "imports": [
        "import asyncio"
      ],
      "cells": [
        {
          "id": "A1",
          "kind": "input",
          "source": "125000",
          "name": "revenue"
        },
        {
          "id": "A2",
          "kind": "input",
          "source": "0.18",
          "name": "tax_rate"
        },
        {
          "id": "A3",
          "kind": "input",
          "source": "[3, 5, 8]",
          "name": "data"
        },
        {
          "id": "B1",
          "kind": "formula",
          "source": "revenue * tax_rate",
          "name": "tax"
        },
        {
          "id": "B2",
          "kind": "formula",
          "source": "revenue - tax",
          "name": "net"
        },
        {
          "id": "B3",
          "kind": "formula",
          "source": "f\"{net:,.2f} of {revenue:,}\"",
          "name": "net_text"
        },
        {
          "id": "B4",
          "kind": "formula",
          "source": "[x * tax_rate for x in data]",
          "name": "scaled"
        },
        {
          "id": "B5",
          "kind": "formula",
          "source": "sorted(data, key=lambda value: -value * tax_rate)",
          "name": "ranked"
        },
        {
          "id": "B6",
          "kind": "formula",
          "source": "# Average with a floor\ntotal = sum(data)\nif total < tax_rate:\n    return 0\nreturn total / len(data)",
          "name": "average"
        },
        {
          "id": "B7",
          "kind": "formula",
          "source": "dict(revenue=revenue, rate=tax_rate)",
          "name": "params"
        },
        {
          "id": "B8",
          "kind": "formula",
          "source": "\"revenue\" + str(revenue)  # revenue in a comment",
          "name": "labelled_text"
        },
        {
          "id": "B9",
          "kind": "formula",
          "source": "revenue.real + data[0]",
          "name": "parts"
        },
        {
          "id": "C1",
          "kind": "effect",
          "source": "print(f\"net: {net}\")",
          "trigger": "manual"
        },
        {
          "id": "D1",
          "kind": "markdown",
          "source": "# Summary\n\nNet: **{{ net }}** of {{ revenue }}\n\n[Rate: {{ tax_rate }}](#sheet-input:tax_rate?type=range&min=0&max=1&step=0.01)",
          "name": "summary"
        },
        {
          "id": "E1",
          "kind": "resource",
          "source": "await asyncio.sleep(0)\nreturn {\"rate\": tax_rate}",
          "name": "loaded"
        },
        {
          "id": "E2",
          "kind": "formula",
          "source": "loaded[\"rate\"] * 2",
          "name": "from_resource"
        }
      ]
    },
